# Receipt-grounded Invoice AI and optional unfamiliar-layout extraction.
GEMINI_API_KEY=

# Gemini model settings.
PROOFLEDGER_GEMINI_MODEL=gemini-3.6-flash
# Google REST enum: minimal, low, medium, or high.
PROOFLEDGER_GEMINI_THINKING_LEVEL=minimal

# Optional, explicit opt-in for unfamiliar-layout invoice extraction.
# Complete deterministic pdfplumber/Tesseract extractions never use this path.
PROOFLEDGER_GEMINI_EXTRACTION_ENABLED=false
PROOFLEDGER_GEMINI_EXTRACTION_MODEL=gemini-3.6-flash
